# Claude API の鍵。無ければ MOCK=1 で動く（缶詰の文章を流す）
ANTHROPIC_API_KEY=
# 筆（モデル）は店が決める。客には見せない。検索（web_search_20260209）が使えるのは Sonnet 5 / Opus 5 以降
BUNPITSUYA_MODEL=claude-sonnet-5
# 後半（6 一筆目・7 見直し・8 仕上げ）だけ重い筆にしたいとき。未指定なら上と同じ
BUNPITSUYA_MODEL_HEAVY=
# 1 にすると API を呼ばず、缶詰の付箋を流す（画面の確認用）
MOCK=

# --- 台帳（無ければログインも控えも無しで動く） ---
# Postgres の接続先。Vercel の Storage で作ると POSTGRES_URL が自動で入る
DATABASE_URL=
# 合言葉に署名する鍵。無いと再デプロイのたびに入り直しになる。openssl rand -base64 32 など
AUTH_SECRET=

# --- 合鍵の便り（無ければログインできない。試用中は SHOW_KEY_ON_SCREEN=1 で代用） ---
RESEND_API_KEY=
MAIL_FROM=文筆屋さん <noreply@bunpitsuya.com>
# 1 にすると、メールを送らず合鍵のリンクを画面に出す。**試用のあいだだけ**
SHOW_KEY_ON_SCREEN=
# 合鍵のリンクに使う住所。未指定ならリクエストの住所を使う
APP_ORIGIN=
